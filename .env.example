# Base de datos
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_PORT=5433

# Backend
BACKEND_IMAGE=kevinho3324/posengine-backend:1.1.0
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://your-server-ip
NODE_ENV=production

# Mantener desactivadas las devoluciones/anulaciones de compra y las anulaciones/restauraciones de ventas
POSENGINE_ENABLE_PURCHASE_RETURNS=false
POSENGINE_ENABLE_PURCHASE_SETTLEMENTS=false
POSENGINE_ENABLE_SUPPLIER_CREDIT_APPLICATIONS=false
POSENGINE_ENABLE_SALE_RETURNS=false
POSENGINE_ENABLE_SALE_REFUNDS=false
POSENGINE_ENABLE_PURCHASE_CANCELLATIONS=false
POSENGINE_ENABLE_SALE_CANCELLATIONS=false
POSENGINE_ENABLE_SALE_RESTORATIONS=false

# Frontend
FRONTEND_IMAGE=kevinho3324/posengine-frontend:1.0.1

# Nginx
NGINX_PORT=80
