# =========================
# Docker Compose (.env)
# =========================
# Copia este archivo a .env en la raíz del proyecto.
# cp .env.example .env

# --- Imágenes y nombres de contenedores (opcional) ---
POSTGRES_IMAGE=postgres:16-alpine
BACKEND_IMAGE=kevinho3324/posengine-backend:1.0.3
NGINX_IMAGE=nginx:alpine
POSTGRES_CONTAINER_NAME=posengine-postgres
BACKEND_CONTAINER_NAME=posengine-backend
NGINX_CONTAINER_NAME=posengine-nginx

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=posengine
POSTGRES_PORT=5433

# --- Backend ---
BACKEND_PORT=3005
BACKEND_INTERNAL_PORT=3005
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=production

# Incluye orígenes web + Tauri desktop
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3006,http://127.0.0.1:3006,http://tauri.localhost,tauri://localhost

# --- Nginx (uploads estáticos) ---
NGINX_PORT=3006

# =========================
# Frontend web (posengine-web/.env.local)
# =========================
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3005
