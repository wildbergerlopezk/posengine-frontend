{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PosEngine",
  "version": "0.1.0",
  "identifier": "com.elytech.posengine",
  "build": {
    "frontendDist": "../../posengine-web/out",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "windows": [
      {
        "title": "PosEngine",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}