model Customer {
  id       String @id @default(uuid())
  tenantId String

  name           String
  taxId          String? // RUC / Identificación tributaria
  documentNumber String? // Número de cédula de identidad
  phone          String?
  email          String?

  address String?

  creditEnabled Boolean @default(false)
  creditLimit   Decimal @default(0) @db.Decimal(12, 2)
  currentDebt   Decimal @default(0) @db.Decimal(12, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  internalReceipts InternalReceipt[] // Relación con comprobantes internos
  sales            Sale[]
  payments         CustomerPayment[]

  @@unique([documentNumber, tenantId])
  @@unique([taxId, tenantId])
  @@index([tenantId])
  @@map("customers")
}
