model Customer {
  id       String @id @default(uuid())
  tenantId String

  name           String
  taxId          String? // RUC / Identificación tributaria
  documentNumber String? // Número de cédula de identidad
  phone          String?
  email          String?

  address String?

  creditEnabled Boolean @default(false)
  creditLimit   Float   @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  //Agregar relación con ventas en el momento que sea necesario 
  @@unique([documentNumber, tenantId])
  @@unique([taxId, tenantId])
  @@map("customers")
}
