enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id       String @id @default(uuid())
  tenantId String

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openingAmount  Decimal  @db.Decimal(12, 2)
  closingAmount  Decimal? @db.Decimal(12, 2)
  expectedAmount Decimal? @db.Decimal(12, 2)
  totalSales     Decimal  @db.Decimal(12, 2) @default(0)
  totalPurchases Decimal  @db.Decimal(12, 2) @default(0)
  difference     Decimal? @db.Decimal(12, 2)

  status      CashSessionStatus @default(OPEN)

  openedBy String 

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  sales     Sale[]
  purchases Purchase[]
  movements CashMovement[]

  @@index([tenantId])
  @@map("cash_sessions")
}
