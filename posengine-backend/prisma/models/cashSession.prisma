enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id       String @id @default(uuid())
  tenantId String

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openingAmount  Decimal  @db.Decimal(12, 2)
  closingAmount  Decimal? @db.Decimal(12, 2)
  expectedAmount Decimal? @db.Decimal(12, 2)
  totalSales     Decimal  @default(0) @db.Decimal(12, 2)
  totalPurchases Decimal  @default(0) @db.Decimal(12, 2)
  difference     Decimal? @db.Decimal(12, 2)

  status CashSessionStatus @default(OPEN)

  openedBy String

  tenant                       Tenant                           @relation(fields: [tenantId], references: [id])
  sales                        Sale[]
  purchases                    Purchase[]
  movements                    CashMovement[]
  customerPayments             CustomerPayment[]
  supplierDebtPayments         PurchaseDebtPayment[]
  paymentClassificationAudits  CashPaymentClassificationAudit[]
  purchaseReturnSettlements    PurchaseReturnSettlement[]
  purchaseReturnRefundReceipts PurchaseReturnRefundReceipt[]
  saleReturnRefundReceipts     SaleReturnRefundReceipt[]

  @@index([tenantId])
  @@map("cash_sessions")
}
