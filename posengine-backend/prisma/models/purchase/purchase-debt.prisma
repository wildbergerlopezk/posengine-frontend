enum PurchaseDebtScheduleType {
  NONE // pago único, sin cuotas, con o sin fecha límite
  OWNER_REMINDER // el dueño se define su propio recordatorio de cuotas
  SUPPLIER_SCHEDULE // cuotas que ya vienen impuestas por el proveedor
}

enum PurchaseDebtStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PurchaseDebtInstallmentStatus {
  PENDING
  PARTIAL
  PAID
}

model PurchaseDebt {
  id         String @id @default(uuid())
  tenantId   String
  purchaseId String @unique

  totalAmount Decimal @db.Decimal(12, 2)
  paidAmount  Decimal @default(0) @db.Decimal(12, 2)
  balance     Decimal @db.Decimal(12, 2)

  scheduleType PurchaseDebtScheduleType @default(NONE)
  dueDate      DateTime? // solo se usa cuando scheduleType es NONE

  status PurchaseDebtStatus @default(PENDING)
  notes  String?

  purchase     Purchase                  @relation(fields: [purchaseId], references: [id])
  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  installments PurchaseDebtInstallment[]
  payments     PurchaseDebtPayment[]
  adjustments  PurchaseDebtAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("purchase_debts")
}

model PurchaseDebtInstallment {
  id             String @id @default(uuid())
  purchaseDebtId String

  number     Int
  amount     Decimal  @db.Decimal(12, 2)
  paidAmount Decimal  @default(0) @db.Decimal(12, 2)
  dueDate    DateTime

  status PurchaseDebtInstallmentStatus @default(PENDING)

  purchaseDebt       PurchaseDebt                      @relation(fields: [purchaseDebtId], references: [id])
  payments           PurchaseDebtPayment[]
  adjustments        PurchaseDebtAdjustment[]
  creditApplications PurchaseReturnCreditApplication[]

  @@index([purchaseDebtId])
  @@map("purchase_debt_installments")
}

model PurchaseDebtAdjustment {
  id               String  @id @default(uuid())
  tenantId         String
  purchaseDebtId   String
  installmentId    String?
  purchaseReturnId String

  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  purchaseDebt   PurchaseDebt             @relation(fields: [purchaseDebtId], references: [id])
  installment    PurchaseDebtInstallment? @relation(fields: [installmentId], references: [id])
  purchaseReturn PurchaseReturn           @relation(fields: [purchaseReturnId], references: [id])
  tenant         Tenant                   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([purchaseDebtId])
  @@index([installmentId])
  @@index([purchaseReturnId])
  @@map("purchase_debt_adjustments")
}

model PurchaseDebtPayment {
  id             String         @id @default(uuid())
  tenantId       String
  purchaseDebtId String
  installmentId  String?
  cashSessionId  String?
  paymentMethod  PaymentMethod?

  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now())
  notes       String?

  purchaseDebt         PurchaseDebt                     @relation(fields: [purchaseDebtId], references: [id])
  installment          PurchaseDebtInstallment?         @relation(fields: [installmentId], references: [id])
  cashSession          CashSession?                     @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  classificationAudits CashPaymentClassificationAudit[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([purchaseDebtId])
  @@index([cashSessionId])
  @@map("purchase_debt_payments")
}
