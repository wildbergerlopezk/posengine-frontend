model PurchaseInstallment {
  id           String @id @default(uuid())
  creditPlanId String

  number     Int
  dueDate    DateTime
  amount     Float
  paidAt     DateTime?
  paidAmount Float?

  status InstallmentStatus @default(PENDING)

  creditPlan PurchaseCreditPlan @relation(fields: [creditPlanId], references: [id])

  @@map("purchase_installments")
}

enum InstallmentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}