model PurchaseItem {
  id         String @id @default(uuid())
  purchaseId String
  productId  String

  quantity  Float
  unitCost  Float
  total     Float

  purchase    Purchase             @relation(fields: [purchaseId], references: [id])
  product     Product              @relation(fields: [productId], references: [id])
  returnItems PurchaseReturnItem[]

  @@map("purchase_items")
}