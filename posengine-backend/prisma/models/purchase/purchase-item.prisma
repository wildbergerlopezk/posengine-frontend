model PurchaseItem {
  id         String @id @default(uuid())
  purchaseId String
  productId  String

  quantity  Float
  unitCost  Float
  taxRate   Float @default(0)
  subtotal  Float
  taxAmount Float @default(0)
  total     Float

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}