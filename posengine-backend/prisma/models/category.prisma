model Category {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  subcategories Subcategory[]
  products      Product[]

  @@unique([name, tenantId])
  @@map("categories")
}
