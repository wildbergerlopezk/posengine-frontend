model Tenant {
    id     String  @id @default(uuid())
    name   String
    slug   String  @unique
    active Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    users         User[]
    categories    Category[]
    subcategories Subcategory[]
    products      Product[]
    suppliers     Supplier[]
    purchases      Purchase[]
    purchaseReturns PurchaseReturn[]
    stockMovements StockMovement[]
}
